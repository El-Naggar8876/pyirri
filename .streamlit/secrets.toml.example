# Example configuration for Google Earth Engine cloud project storage.
# Copy this file to ".streamlit/secrets.toml" and fill in real values.
# Never commit the populated file.  The .gitignore for this repository
# already excludes ".streamlit/secrets.toml".

[gee]
project_id      = "your-gcp-project-id"
service_account = "service-account-name@your-gcp-project-id.iam.gserviceaccount.com"
private_key     = """-----BEGIN PRIVATE KEY-----
PASTE THE FULL PEM-ENCODED KEY HERE
-----END PRIVATE KEY-----
"""
