# =============================================================================
# OPTIONAL — Google Earth Engine cloud project storage configuration
# =============================================================================
#
# PyIrri runs WITHOUT this file. Configure it only if you want PyIrri to
# save and load project snapshots to your own Google Earth Engine assets.
#
# To enable:
#   1. In Google Cloud Console (https://console.cloud.google.com), create a
#      project and a service account, and grant it the
#      "Earth Engine Resource Admin" role.
#   2. Enable the Earth Engine API for that project.
#   3. Generate a JSON key for the service account and copy the values from
#      that JSON into this file.
#   4. Save this file as ".streamlit/secrets.toml" (NOT *.example) and
#      restart the application.
#
# SECURITY:
#   * Each user must use THEIR OWN credentials. Never share or commit a
#     populated secrets.toml.
#   * The repository .gitignore already excludes ".streamlit/secrets.toml".
#   * If a private key is ever exposed, revoke it immediately in the GCP
#     Console (IAM & Admin -> Service Accounts -> Keys).
# =============================================================================

[gee]
project_id      = "your-gcp-project-id"
service_account = "service-account-name@your-gcp-project-id.iam.gserviceaccount.com"
private_key     = """-----BEGIN PRIVATE KEY-----
PASTE THE FULL PEM-ENCODED KEY HERE
-----END PRIVATE KEY-----
"""
